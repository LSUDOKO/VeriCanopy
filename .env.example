# ---- chain ----
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DEPLOYER_KEY=                     # testnet only; anvil default key used by `make deploy` when empty
ORACLE_PRIVATE_KEY=               # testnet only
RESOLVER_KEYS=                    # comma-separated, testnet only (resolver CLI)
DEPLOYMENTS_FILE=./contracts/deployments/31337.json
USE_MOCK_VERIFIER=false           # true => deploy MockVerifier instead of Halo2Verifier
ZK_MODE=onchain                   # onchain | offchain (documented fallback, see docs/LIMITATIONS.md)
# ---- backend ----
DATABASE_URL=sqlite:///./data/vericanopy.db   # or postgresql+psycopg://vc:vc@localhost:5432/vericanopy
REDIS_URL=redis://localhost:6379/0
ADMIN_API_KEY=change-me
IPFS_API_URL=                     # optional kubo API, e.g. http://localhost:5001
IPFS_GATEWAY=https://ipfs.io/ipfs/
API_URL=http://127.0.0.1:8000
# ---- AI / Earth Engine ----
EE_SERVICE_ACCOUNT_JSON=          # path to service account JSON; empty => fixture provider
EE_PROJECT=
PQ_SECRET_KEY_PATH=./secrets/ml_dsa_65.sk
PQ_PUBLIC_KEY_PATH=./secrets/ml_dsa_65.pk
# ---- web ----
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
