pragma solidity ^0.8.24;

import {BaseTest} from "./Base.t.sol";
import {IIntegrityOracle} from "../src/interfaces/IIntegrityOracle.sol";
import {IHalo2Verifier} from "../src/interfaces/IHalo2Verifier.sol";

/// @dev Uses the real EZKL verifier (compiled by scripts/compile_verifier.py) and a real proof fixture generated by
///      ai/zk/prove.py for Demo Project A, period 2024.
contract IntegrityOracleZkTest is BaseTest {
    bytes32 realModel = keccak256("real-model");
    address realVerifier;
    bytes proof;
    uint256[] instances;
    uint16 expectedBps;
    uint8 outputScale;

    function setUp() public override {
        super.setUp();
        string memory art = vm.readFile("verifier/Halo2Verifier.json");
        bytes memory code = vm.parseJsonBytes(art, ".bytecode");
        address v;
        assembly {
            v := create(0, add(code, 0x20), mload(code))
        }
        require(v != address(0), "verifier deploy failed");
        realVerifier = v;
        string memory fx = vm.readFile("test/fixtures/proof_A_2024.json");
        proof = vm.parseJsonBytes(fx, ".proof");
        string[] memory ins = vm.parseJsonStringArray(fx, ".instances");
        for (uint256 i = 0; i < ins.length; ++i) {
            instances.push(vm.parseUint(ins[i]));
        }
        expectedBps = uint16(vm.parseJsonUint(fx, ".score_bps"));
        outputScale = uint8(vm.parseJsonUint(fx, ".output_scale"));
        vm.prank(gov);
        models.registerModel(realModel, realVerifier, "ipfs://real", 1, outputScale);
    }

    function test_real_verifier_accepts_fixture() public {
        assertTrue(IHalo2Verifier(realVerifier).verifyProof(proof, instances));
        assertLe(realVerifier.code.length, 24576);
    }

    function test_real_proof_verifies_and_decodes_score() public {
        vm.prank(oracleEoa);
        uint256 id = oracle.submitScore{
            value: STAKE
        }(pid, 2024, realModel, 0, keccak256("m"), "bafy", pqKeyId, proof, instances);
        IIntegrityOracle.Submission memory s = oracle.getSubmission(id);
        assertEq(s.scoreBps, expectedBps);
        assertEq(s.featureCommitment, bytes32(instances[0]));
    }

    function test_tampered_proof_reverts() public {
        bytes memory bad = proof;
        bad[100] = bytes1(uint8(bad[100]) ^ 0x01);
        vm.prank(oracleEoa);
        vm.expectRevert(IIntegrityOracle.InvalidZkProof.selector);
        oracle.submitScore{value: STAKE}(pid, 2024, realModel, 0, keccak256("m"), "bafy", pqKeyId, bad, instances);
        uint256[] memory badIns = instances;
        badIns[1] = instances[1] + 1; // claim a different score
        vm.prank(oracleEoa);
        vm.expectRevert(IIntegrityOracle.InvalidZkProof.selector);
        oracle.submitScore{value: STAKE}(pid, 2024, realModel, 0, keccak256("m"), "bafy", pqKeyId, proof, badIns);
    }
}
